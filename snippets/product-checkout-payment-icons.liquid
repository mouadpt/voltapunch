{% comment %}
  Always-visible payment methods displayed directly below the product checkout button.
{% endcomment %}
<div class="checkout-payment-methods" aria-label="Métodos de pagamento aceites">
  <ul class="checkout-payment-methods-list" role="list">
    <li class="checkout-payment-method checkout-payment-method-mbway" aria-label="MB WAY">MB WAY</li>
    <li class="checkout-payment-method checkout-payment-method-multibanco" aria-label="Multibanco">MULTIBANCO</li>
    <li class="checkout-payment-method checkout-payment-method-klarna" aria-label="Klarna">Klarna.</li>
    <li class="checkout-payment-method checkout-payment-method-visa" aria-label="Visa">VISA</li>
    <li class="checkout-payment-method checkout-payment-method-mastercard" aria-label="Mastercard">
      <span aria-hidden="true"></span>
    </li>
    <li class="checkout-payment-method checkout-payment-method-paypal" aria-label="PayPal">PayPal</li>
  </ul>
</div>
